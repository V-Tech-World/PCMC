# ============================================================
# VoiceCare backend - template. Copy to .env and fill in.
#   cp .env.example .env
# .env is git-ignored; NEVER commit it or the real keys.
# ============================================================

# ---- Zernio telephony (required) ----
ZERNIO_API_KEY=sk_replace_with_your_zernio_api_key
# Real caller ID in E.164 (e.g. +18888344640). The app REFUSES placeholders:
# Zernio would fall back to the account's default (local) caller ID instead.
FROM_NUMBER=+1888XXXXXXX

# Expose the backend with:  ngrok http 8000
# then set the wss:// URL with /media-stream appended:
PUBLIC_WSS_URL=wss://YOUR-STATIC-DOMAIN.ngrok-free.dev/media-stream

# ---- Manual "call now" endpoint guard (required) ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# POST /calls must then send header:  X-Api-Key: <this value>
CALLS_API_KEY=change-me-long-random-string

# ---- Call script ----
HOSPITAL_NAME=VoiceCare
# Optional override of the default survey-informed opening line:
# GREETING_TEXT=This is a short automated check-in call from VoiceCare. ...

# ---- Safety rails ----
# Comma-separated E.164 prefixes the backend is allowed to dial.
ALLOWED_CALL_PREFIXES=+94
# Reject WebSocket connections without a valid per-call token:
MEDIA_STREAM_REQUIRE_TOKEN=true

# Default number for POST /calls when the body omits phone_number.
TEST_TO_NUMBER=+94XXXXXXXXX

# ---- Runtime ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
# RECORDINGS_DIR=recordings   # defaults to backend/recordings

# ---- Speech-to-text (Step 2) ----
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
# Transcribe a 1 s tone at boot. Cheap insurance: a faster-whisper/PyAV clash
# only shows up on the FIRST patient answer, by which time the call is dead.
STT_VERIFY_ON_START=true


# ---- Text-to-speech + dialogue (Step 3) ----
TTS_BACKEND=auto          # auto | pyttsx3 | gtts (gtts needs ffmpeg + internet)
TTS_RATE=160              # pyttsx3 speech rate (words/min). Lower = clearer/slower
# TTS_VOICE=Zira          # voice name substring; empty = system default.
                          # List installed voices: python tools/tts_preview.py --list-voices
                          # Preview what the patient hears (no call, no cost):
                          #   python tools/tts_preview.py --script surgical
TTS_BANDPASS_ENABLED=true # 300-3400 Hz phone-band filter + level match on our audio
SPEAK_CODEC=pcmu          # codec for audio WE send: pcmu (the provider's bidirectional
                          # codec, per Zernio docs) | pcma | auto (mirror inbound).
                          # The wrong value here = distorted questions on the call.
FILLER_ENABLED=true      # "One moment, please." the instant the patient stops
                          # talking: covers the 1-2 s of STT+TTS with a voice
                          # instead of dead air. Only worth turning off with a
                          # very fast STT model AND if patients prefer silence.
DIALOGUE_ENABLED=true     # false = Step 1/2 passthrough (record only, no questions)
# The final question says "speak clearly after the beep" -- this is the beep.
# Two short tones (frequency, duration each) with a gap, faded at both ends.
BEEP_ENABLED=true
BEEP_FREQUENCY_HZ=1000   # telephony dial tone
BEEP_DURATION_MS=350
# How many times one question may go unheard before we apologise and close the
# call. 2 = ask once + one repeat, then stop -- never walk a silent or absent
# patient through the rest of the script.
MAX_SILENT_ATTEMPTS=2
TURN_SILENCE_SEC=1.2      # silence that ends a spoken answer
TURN_MAX_SEC=10           # hard cap per answer (README: 8-10s)
TURN_GAP_SEC=2.5          # no media frames for this long -> turn over
FINAL_ANSWER_SEC=60       # fixed capture window for the final open question;
                          # honoured in full -- silence does not cut it short
                          # once the patient has started speaking
FINAL_ANSWER_PATIENCE_SEC=15
                          # ...but if they have said NOTHING by then we stop
                          # waiting, instead of holding a billed line for 60 s
HANGUP_GRACE_SEC=60       # after the goodbye, stay quiet and let the PATIENT
                          # hang up; if they are still connected this long
                          # later, we disconnect for them. 0 = close at once.

# ---- Cost rails (call duration + rate limits, Step 5) ----
# Every answered minute is a billed provider minute. These guards make a
# runaway call (never hangs up) or a runaway dialing loop impossible.
MAX_CALL_DURATION_SEC=300   # hard wall-clock cap per call; the dialogue aborts
                            # and the risk assessment is still logged/saved
MAX_CONCURRENT_CALLS=3      # live media streams allowed at once (0 = unlimited)
MAX_CALLS_PER_HOUR=30       # POST /calls sliding-window limit (0 = unlimited)
MAX_CALLS_PER_DAY=200       # POST /calls daily limit (0 = unlimited)

# ---- Database (Step 6) ----
# Empty = backend/voicecare.db (SQLite). Set to a SQLAlchemy URL to override,
# e.g. sqlite:////absolute/path/voicecare.db
DATABASE_URL=

# ---- Alerts for HIGH-risk calls (Step 7) ----
# Every HIGH-risk call ALWAYS gets its alert text built and stored on the call
# row (the dashboard call detail shows it with a Copy button).
# ALERT_DELIVERY decides whether that text is also pushed anywhere:
#   ready    (default) = prepare + store only; nothing leaves the backend
#   whatsapp           = also post the SHORT alert into the conversation below
ALERTS_ENABLED=true
ALERT_DELIVERY=ready
# ---- Staff email alerts (4 Oct 2026, assignment routing 5 Oct 2026) ----
# Every HIGH-risk call is ALSO emailed to the nurse(s) and doctor(s) ASSIGNED
# to that patient (set on the Patients screen when registering the patient).
# No score threshold: a patient with nobody assigned gets NO email -- the call
# row records an explicit "no_assignment" note instead (WhatsApp still goes out,
# independent of ALERT_DELIVERY above).
EMAIL_ALERTS_ENABLED=true
# The From: address on every alert. Must be the Gmail account the password below
# belongs to.
SENDER_EMAIL=
# A Gmail App Password (NOT the account password):
# Google Account -> Security -> 2-Step Verification -> App passwords.
# Without BOTH of these, the alert text is still stored on the call row and the
# row records who should have been emailed -- nothing is sent, nothing is lost.
GOOGLE_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Zernio inbox account id (dashboard > Inbox).
ZERNIO_INBOX_ACCOUNT_ID=replace_with_sandbox_account_id
# The care team's WhatsApp conversation. IMPORTANT: a WhatsApp conversation only
# stays open for 24 hours, and the app never opens one itself -- run
#     python get-info.py
# (an ops script, deliberately outside the app) to open/re-open it, then paste
# the printed conversationId here.
ZERNIO_ALERT_CONVERSATION_ID=replace_with_sandbox_conversation_id
# Optional: care-team number used by get-info.py (digits + country code, no '+').
# ALERT_WHATSAPP_TO=94771234567
# Optional: the approved WhatsApp template that starts the thread.
# ZERNIO_ALERT_TEMPLATE=sandbox_start


# Answering-machine detection (Zernio amd, default OFF).
#   false (default): the stream bridges as soon as the call is answered --
#                    live-tested and confirmed working. Risk: if the call
#                    lands in a voicemail box our dialogue will talk to the
#                    announcement (mitigated by the runaway-dialogue guard).
#   true:            Zernio waits until human vs machine is known before
#                    bridging. Stops the voicemail case, BUT a live test
#                    showed it can block the bridge entirely when the callee
#                    answers and stays silent -- do not enable globally until
#                    that is re-validated with Zernio.
# Per-call override: POST /calls with {"amd": true} in the body.
CALL_AMD=false

# ---- Follow-up call scheduler / cronjob (Step 8) ----
# SCHEDULE_CALLS_ENABLED is the master switch and the ONLY thing that can make
# the backend dial without a human pressing a button. Production deployments
# may prefer REMOVING it from the env so the dashboard switch is the only knob
# (then a fresh database starts with auto-dial OFF and the choice is persisted
# in the DB from the first toggle on).
#   false (default, what this demo ships with): the app never dials on its own.
#       GET /schedule still returns each patient's real next-call time, so the
#       dashboard column is live data -- and POST /schedule/run-now returns the
#       dial plan while placing zero calls.
#   true: an in-process APScheduler job wakes every SCHEDULE_INTERVAL_MINUTES,
#       finds patients whose check-in is due and dials them through exactly the
#       same cost rails as a manual call.
SCHEDULE_CALLS_ENABLED=false
SCHEDULE_CHECKIN_DAYS=3,7,14,30  # day offsets after DISCHARGE_DATE (survey: weekly-ish)
SCHEDULE_HOUR=9                  # local hour a check-in becomes due
SCHEDULE_MINUTE=0
SCHEDULE_INTERVAL_MINUTES=30     # how often the tick looks for due patients
SCHEDULE_GRACE_DAYS=2            # catch-up window; older slots are never dialed
SCHEDULE_MAX_DIALS_PER_TICK=2    # hard cap per tick (cost rail)
SCHEDULE_MIN_HOURS_BETWEEN_CALLS=24.0  # per-patient auto-dial cooldown: the automatic tick skips a patient dialed (manually OR automatically) less than this many hours ago; manual Call Now is never blocked
SCHEDULE_DRY_RUN=false           # true = log the plan, dial nothing

# ---- Dashboard auth (Step 9) ----
# One shared dashboard, three roles: nurse | doctor | admin. No patient logins.
# JWT_SECRET signs staff tokens; empty falls back to CALLS_API_KEY (above) so a
# fresh checkout can log in. If BOTH are empty, /auth/login returns 503.
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
# First admin, seeded on startup when no staff account exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_the_demo
ADMIN_DISPLAY_NAME=System Administrator
# Mailbox for the seeded admin. Optional (admins are never emailed by score),
# but set it so every account on the Staff screen has a sane value.
ADMIN_EMAIL=
DEFAULT_HOSPITAL=VoiceCare
# Browser origins allowed to call the API (the Vite dev server).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

