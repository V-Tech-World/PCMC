# ==============================================================================
# VoiceCare LK (project-specific)
# ==============================================================================
# Frontend (Vite/Node)
node_modules/
*.tsbuildinfo

# Patient call audio + transcripts (sensitive health data). Never commit.
recordings/
backend/recordings/

# Generated/preview audio from offline dev tools.
backend/recordings/previews/

# Ad-hoc diagnostic leftovers (scratch, not source).
collected.txt
testmap.txt
backend/collected.txt
backend/testmap.txt

# Runtime logs. Rotate 2 MB x 5 in backend/logs/voicecare.log -- can contain
# transcripts of patient speech, so never commit (same rule as recordings/).
backend/logs/
logs/
